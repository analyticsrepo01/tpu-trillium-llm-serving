# Google Cloud Configuration
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=europe-west4 # or us-central1
STAGING_BUCKET=gs://your-staging-bucket-name

# Model Garden / Framework Configuration
GOOGLE_GENAI_USE_VERTEXAI=True

# Hugging Face Access Token (Required for gated models like Meta-Llama-3.1 / 3.3)
HF_TOKEN=hf_your_hugging_face_read_token_here
